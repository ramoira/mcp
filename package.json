{
  "name": "@ramoira/mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the Ramoira brand schema specification to any LLM",
  "type": "module",
  "bin": {
    "ramoira-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsup src/server.ts --format esm --dts --out-dir dist",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
